# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

# ── 运行产物：一期一个文件夹，每次跑都会重建，不进库 ───────────────
# 命名规律：年份 + 地区 + 系列 + 期号 + 标题，形如
#   2026广东申论日报-第01期-xxx/
#   2026广东申论早报-第001期-xxx/
# 用「年份开头 + 期」的形态精确排除，不写 *.pdf / *.png 整类规则
# （会把 preview-*.jpg 和 assets/offcn.png 一起吞掉）
20[0-9][0-9]*申论日报-第*/
20[0-9][0-9]*申论早报-第*/
20[0-9][0-9]*申论日报-第*.pdf
20[0-9][0-9]*申论日报-第*.png
20[0-9][0-9]*申论早报-第*.pdf
20[0-9][0-9]*申论早报-第*.png

# ── 中间产物 ─────────────────────────────────────────────────────
# --keep-html 会留一份中间 HTML，文件名是 file_name（申论日报-第… / 申论早报-第…）
# 按前缀精确排除，不写 *.html 整类规则（会连模板一起吞掉，且 git add 不报错）
申论日报-第*.html
申论早报-第*.html
shenlun_*/
*.tmp

# ── 自己的 content.json（真实选题，不进库；examples/ 里的样例要进）──
/content.json
/早报.json
!shenlun-daily/examples/*.json

# ── 编辑器 / 系统 ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── 敏感信息 ─────────────────────────────────────────────────────
.env
.env.*
*.pem
*.key
token.txt
